<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: copia en la nube y transferencia de dispositivo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_update.xml" />
        <exclude domain="external" path="apk_history/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_update.xml" />
        <exclude domain="external" path="apk_history/" />
    </device-transfer>
</data-extraction-rules>
