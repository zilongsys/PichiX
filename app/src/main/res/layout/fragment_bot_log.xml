<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/bot_log_title"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:ellipsize="end" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBotLogScrollTop"
            style="@style/SparkTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/bot_log_scroll_top"
            android:textSize="10sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBotLogScrollBottom"
            style="@style/SparkTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="@string/bot_log_scroll_bottom"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvBotLogHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/bot_log_hint"
        android:textColor="@color/text_hint"
        android:textSize="10sp"
        android:singleLine="true"
        android:ellipsize="end"
        android:layout_marginBottom="6dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="4dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleBotLogCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/tvBotLogPageInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_hint"
        android:textSize="9sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="4dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBotLogLoadMore"
        style="@style/SparkButtonSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="@string/bot_log_load_more"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        style="@style/Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginBottom="8dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBotLog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fadeScrollbars="true"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />
    </LinearLayout>

    <android.widget.GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="1"
        android:alignmentMode="alignBounds"
        android:columnOrderPreserved="false"
        android:useDefaultMargins="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBotLogClearToday"
            style="@style/HistorialActionButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/hist_action_btn_height"
            android:layout_columnWeight="1"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_marginEnd="3dp"
            android:backgroundTint="@color/hist_action_today_bg"
            android:contentDescription="@string/bot_log_clear_today"
            android:text="@string/bot_log_clear_today"
            app:icon="@drawable/ic_hist_trash_today" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBotLogClearAll"
            style="@style/HistorialActionButton"
            android:layout_width="0dp"
            android:layout_height="@dimen/hist_action_btn_height"
            android:layout_columnWeight="1"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_marginStart="3dp"
            android:backgroundTint="@color/hist_action_all_bg"
            android:contentDescription="@string/bot_log_clear_all"
            android:text="@string/bot_log_clear_all"
            app:icon="@drawable/ic_hist_trash_all" />
    </android.widget.GridLayout>

</LinearLayout>
