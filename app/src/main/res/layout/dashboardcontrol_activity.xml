<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla "Conexión con PC" (dashboardcontrol). Usa los estilos de la app: Card, SectionLabel, RowHint, SparkButton*. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/dcBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver"
                android:src="?attr/homeAsUpIndicator"
                android:tint="@color/text_primary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Conexión con PC"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="4dp"
            android:text="Estado" />

        <LinearLayout
            style="@style/Card"
            android:padding="16dp">

            <TextView
                android:id="@+id/dcStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dcDetail"
                style="@style/RowHint"
                android:layout_width="match_parent"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/dcPending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:text="Centro de control" />

        <LinearLayout
            style="@style/Card"
            android:padding="16dp">

            <TextView
                style="@style/RowHint"
                android:layout_width="match_parent"
                android:layout_marginTop="0dp"
                android:text="Copia IP, puerto y token del panel izquierdo del Centro de control en la PC (misma Wi‑Fi)." />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/PichiXTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="IP de la PC"
                app:placeholderText="192.168.0.148">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/dcHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textUri|textNoSuggestions"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textCursorDrawable="@drawable/text_cursor_accent"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/PichiXTextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="Puerto"
                    app:placeholderText="8765">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/dcPort"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textCursorDrawable="@drawable/text_cursor_accent"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/PichiXTextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Ruta"
                    app:placeholderText="/agent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/dcPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textUri|textNoSuggestions"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textCursorDrawable="@drawable/text_cursor_accent"
                        android:textSize="16sp" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/PichiXTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Token"
                app:placeholderText="ABCD-EFGH">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/dcToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textCursorDrawable="@drawable/text_cursor_accent"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/dcUrlPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@color/bg_input"
                android:fontFamily="monospace"
                android:padding="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                style="@style/RowHint"
                android:layout_width="match_parent"
                android:text="Por defecto: puerto 8765 y ruta /agent. Solo cámbialos si el Centro de control muestra otra cosa." />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/dcEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="Conectar con la PC"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <TextView
                style="@style/RowHint"
                android:layout_width="match_parent"
                android:text="Activado, todo lo que hace el bot se guarda en el teléfono y se envía a la PC. Si la PC no está, se envía al reconectar." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dcSave"
                style="@style/SparkButtonPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Guardar y conectar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dcRetry"
                style="@style/SparkButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Reintentar ahora" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:text="Pendientes de enviar" />

        <LinearLayout
            style="@style/Card"
            android:padding="16dp">

            <TextView
                style="@style/RowHint"
                android:layout_width="match_parent"
                android:layout_marginTop="0dp"
                android:text="Se guardan hasta 7 días. Borrarlos no afecta al bot ni al historial de la app, pero la PC no los recibirá." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dcClear"
                style="@style/SparkButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Borrar pendientes" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
