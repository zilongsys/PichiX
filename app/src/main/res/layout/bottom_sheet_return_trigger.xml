<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvReturnTriggerSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/config_return_trigger_edit_title"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/PichiXTextInputLayout"
        android:hint="@string/config_return_trigger_label_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReturnTriggerLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="@style/PichiXTextInputLayout"
        android:hint="@string/config_return_trigger_phrases_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReturnTriggerPhrases"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:inputType="textMultiLine"
            android:minLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/config_return_trigger_match_label"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleReturnTriggerMatch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:singleSelection="true"
        app:selectionRequired="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReturnTriggerContains"
            style="@style/SparkThemeToggleButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/config_screen_match_contains" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReturnTriggerExact"
            style="@style/SparkThemeToggleButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/config_screen_match_exact" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <LinearLayout
        style="@style/Row"
        android:layout_marginTop="8dp">

        <TextView
            style="@style/RowLabel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/config_return_trigger_ignore_case" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchReturnTriggerIgnoreCase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReturnTriggerDelete"
            style="@style/SparkButtonSecondary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/config_return_trigger_delete"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReturnTriggerSave"
            style="@style/SparkButtonPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/config_return_trigger_save" />
    </LinearLayout>
</LinearLayout>
