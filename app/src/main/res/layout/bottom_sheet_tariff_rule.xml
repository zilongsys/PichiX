<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollTariffRuleSheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_card"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:focusable="false"
    android:focusableInTouchMode="false"
    android:overScrollMode="ifContentScrolls"
    android:padding="20dp"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:descendantFocusability="afterDescendants"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSheetTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nueva regla"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/TariffRuleInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Nombre (opcional)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRuleName"
                style="@style/TariffRuleInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/SectionLabelCompact"
            android:text="Alcance estación" />

        <Spinner
            android:id="@+id/spinnerRuleScope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutStorePattern"
            style="@style/TariffRuleInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Patrón estación">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRuleStorePattern"
                style="@style/TariffRuleInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            style="@style/SectionLabelCompact"
            android:layout_marginTop="4dp"
            android:text="Tipo de bloque Flex" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/frameBlockTypePreview"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/badge_flex_all">

                <ImageView
                    android:id="@+id/ivBlockTypePreview"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_flex_all_blocks"
                    app:tint="@color/flex_block_all_icon" />
            </FrameLayout>

            <Spinner
                android:id="@+id/spinnerRuleOrderType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabelCompact"
            android:layout_marginTop="8dp"
            android:text="Criterio de pago" />

        <Spinner
            android:id="@+id/spinnerPayMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/layoutPayBlock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/TariffRuleInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Pago mín $">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRulePriceMin"
                    style="@style/TariffRuleInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/TariffRuleInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Pago máx (vacío=∞)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRulePriceMax"
                    style="@style/TariffRuleInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPayHourly"
            style="@style/TariffRuleInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="$/hora mínimo"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRuleMinRate"
                style="@style/TariffRuleInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPayManualFixed"
            style="@style/TariffRuleInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Precio exacto del bloque $"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRuleManualPrice"
                style="@style/TariffRuleInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvPayManualAny"
            style="@style/InfoBox"
            android:layout_marginTop="8dp"
            android:text="Manual (cualquier precio): no se filtra por monto."
            android:visibility="gone" />

        <TextView
            style="@style/SectionLabelCompact"
            android:layout_marginTop="8dp"
            android:text="Duración mínima / máxima del bloque" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Formato h.min (ej. 3.30 = 3 horas y 30 min; también 3:30). Deja vacío = cualquier duración. Aplica a todos los tipos."
            android:textColor="@color/text_hint"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/TariffRuleInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hint="Mín h.min (ej. 3.30)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRuleMinDuration"
                    style="@style/TariffRuleInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/TariffRuleInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Máx h.min (vacío=∞)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRuleMaxDuration"
                    style="@style/TariffRuleInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/RowCompact"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hora inicio del bloque (rango)"
                android:textColor="@color/text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchBlockStartWindow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutBlockStartWindow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutBlockStartFrom"
                style="@style/TariffRuleInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:endIconDrawable="@android:drawable/ic_menu_recent_history"
                app:endIconMode="custom"
                app:endIconTint="@color/text_secondary"
                android:hint="Desde">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBlockStartFrom"
                    style="@style/TariffRuleInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutBlockStartTo"
                style="@style/TariffRuleInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:endIconDrawable="@android:drawable/ic_menu_recent_history"
                app:endIconMode="custom"
                app:endIconTint="@color/text_secondary"
                android:hint="Hasta">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBlockStartTo"
                    style="@style/TariffRuleInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <TextView
            style="@style/SectionLabelCompact"
            android:layout_marginTop="8dp"
            android:text="Anticipación mínima" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Tiempo mínimo antes del inicio del bloque (escribe h:mm, ej. 2:30). Vacío = sin límite."
            android:textColor="@color/text_hint"
            android:textSize="11sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutLeadTime"
            style="@style/TariffRuleInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Anticipación h:mm">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRuleLeadTime"
                style="@style/TariffRuleInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            style="@style/RowCompact"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Horario activo de la regla (teléfono)"
                android:textColor="@color/text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchRuleTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutRuleTimeFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRuleTimeStart"
                style="@style/TariffRuleInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                app:endIconDrawable="@android:drawable/ic_menu_recent_history"
                app:endIconMode="custom"
                app:endIconTint="@color/text_secondary"
                android:hint="Desde">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRuleTimeStart"
                    style="@style/TariffRuleInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutRuleTimeTo"
                style="@style/TariffRuleInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                app:endIconDrawable="@android:drawable/ic_menu_recent_history"
                app:endIconMode="custom"
                app:endIconTint="@color/text_secondary"
                android:hint="Hasta">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRuleTimeEnd"
                    style="@style/TariffRuleInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/RowCompact"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Filtrar por días"
                android:textColor="@color/text_primary" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchRuleWeekdays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupRuleWeekdays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="6dp" />

        <TextView
            style="@style/SectionLabelCompact"
            android:text="Keywords excluidos (opcional)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRuleAddKeyword"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                android:hint="ej: Fresh, Pharmacy"
                android:inputType="text"
                android:maxLines="1"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRuleAddKeyword"
                style="@style/OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="+ Agregar"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupRuleKeywords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:descendantFocusability="afterDescendants"
            android:focusable="false"
            android:focusableInTouchMode="false"
            app:chipSpacingHorizontal="6dp"
            app:chipSpacingVertical="6dp"
            app:chipStyle="@style/DarkChip" />

        <TextView
            android:id="@+id/tvRulePreview"
            style="@style/InfoBox"
            android:layout_marginTop="12dp"
            android:text="Vista previa" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRuleCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRuleSave"
                style="@style/SparkButtonPrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Guardar" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
