<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/configScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="14dp"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/headerSectionAmazon"
            style="@style/SectionLabel"
            android:layout_marginTop="4dp"
            android:text="AMAZON FLEX" />

        <LinearLayout
            android:id="@+id/sectionAmazon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout style="@style/Card">

            <LinearLayout style="@style/Row">
                <TextView
                    style="@style/RowLabel"
                    android:text="Paquete de Amazon Flex" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFlexPackage"
                style="@style/MediumInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="12dp"
                android:hint="com.amazon.rabbit"
                android:inputType="text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="12dp"
                android:text="@string/config_flex_package_helper"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/headerSectionPermisos"
            style="@style/SectionLabel"
            android:text="PERMISOS" />

        <LinearLayout
            android:id="@+id/sectionPermisos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout style="@style/Card">

            <LinearLayout style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="match_parent"
                        android:layout_weight="0"
                        android:text="Accesibilidad" />
                    <TextView
                        android:id="@+id/tvAccessStatus"
                        style="@style/RowHint"
                        android:text="No activado" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoAccess"
                style="@style/SparkButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/config_btn_accessibility" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoNotifications"
                style="@style/SparkButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="14dp"
                android:text="Acceso a notificaciones (Flex)" />
        </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/headerSectionAuto"
            style="@style/SectionLabel"
            android:text="AUTOMATIZACIÓN FLEX" />

        <LinearLayout
            android:id="@+id/sectionAuto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout style="@style/Card">

            <LinearLayout style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="match_parent"
                        android:layout_weight="0"
                        android:text="@string/config_return_2_offers_title" />
                    <TextView
                        style="@style/RowHint"
                        android:text="@string/config_return_2_offers_hint" />
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchReturn2Offers"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <LinearLayout style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="match_parent"
                        android:layout_weight="0"
                        android:text="@string/config_auto_accept_title" />
                    <TextView
                        style="@style/RowHint"
                        android:text="@string/config_auto_accept_hint" />
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFlexAutoAccept"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <LinearLayout style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="match_parent"
                        android:layout_weight="0"
                        android:text="@string/config_flex_foreground_title" />
                    <TextView
                        style="@style/RowHint"
                        android:text="@string/config_flex_foreground_hint" />
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFlexOnlyForeground"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/headerSectionClicks"
            style="@style/SectionLabel"
            android:text="@string/config_section_bot_clicks" />

        <LinearLayout
            android:id="@+id/sectionClicks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout style="@style/Card">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/config_click_mode_label"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleClickMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="10dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClickModeBasic"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/config_click_mode_basic" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClickModeSmart"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/config_click_mode_smart" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:id="@+id/layoutBasicClick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/config_basic_interval_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etBasicClickIntervalSec"
                    style="@style/MediumInput"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="8dp"
                    android:hint="3"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutSmartClick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/config_smart_click_range_label"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSmartClickMinSec"
                    style="@style/MediumInput"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1"
                    android:hint="1"
                    android:inputType="number" />

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSmartClickMaxSec"
                    style="@style/MediumInput"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="6dp"
                    android:layout_weight="1"
                    android:hint="6"
                    android:inputType="number" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="match_parent"
                        android:layout_weight="0"
                        android:text="@string/config_click_refresh_title" />
                    <TextView
                        style="@style/RowHint"
                        android:text="@string/config_click_refresh_hint" />
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchClickRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/DividerFull" />

            <LinearLayout style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="match_parent"
                        android:layout_weight="0"
                        android:text="@string/config_auto_scroll_title" />
                    <TextView
                        style="@style/RowHint"
                        android:text="@string/config_auto_scroll_hint" />
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAutoScroll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View style="@style/DividerFull" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/config_offer_pick_label"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleOfferPickMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="6dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOfferPickFirst"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/config_offer_pick_first" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOfferPickBest"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/config_offer_pick_best" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/tvOfferRankLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/config_offer_rank_label"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleOfferRank"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="8dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRankHourly"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_offer_rank_hourly" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRankBlockPay"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_offer_rank_block" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRankDurationMin"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_offer_rank_dur_min" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRankStartSoon"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/config_offer_rank_start" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/config_refresh_button_text_label"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRefreshButtonText"
                style="@style/MediumInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="8dp"
                android:hint="Refresh"
                android:inputType="text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="4dp"
                android:text="@string/config_text_match_mode_label"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleRefreshButtonMatchMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="6dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefreshMatchContains"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/config_screen_match_contains" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRefreshMatchExact"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/config_screen_match_exact" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout style="@style/Row">
                <TextView
                    style="@style/RowLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/config_ignore_case_label" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchRefreshButtonIgnoreCase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/config_click_screen_text_label"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etClickScreenText"
                style="@style/MediumInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="8dp"
                android:hint="@string/config_click_screen_text_hint"
                android:inputType="text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="4dp"
                android:text="@string/config_screen_match_mode_label"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="6dp"
                android:text="@string/config_screen_case_hint"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleScreenMatchMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="12dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScreenMatchContains"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/config_screen_match_contains" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScreenMatchExact"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/config_screen_match_exact" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout style="@style/Row">
                <TextView
                    style="@style/RowLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/config_ignore_case_label" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchScreenIgnoreCase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="14dp"
                android:text="@string/config_bot_clicks_helper"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/headerSectionPause"
            style="@style/SectionLabel"
            android:text="PAUSE BY OVER CLICKS" />

        <LinearLayout
            android:id="@+id/sectionPause"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout style="@style/Card">

            <LinearLayout style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="match_parent"
                        android:layout_weight="0"
                        android:text="@string/config_pause_over_clicks_title" />
                    <TextView
                        style="@style/RowHint"
                        android:text="@string/config_pause_over_clicks_hint" />
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchPauseOverClicks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginTop="4dp"
                android:text="@string/config_pause_over_clicks_match_label"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPauseOverClicksText"
                style="@style/MediumInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="8dp"
                android:hint="@string/config_pause_over_clicks_match_hint"
                android:inputType="text" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/togglePauseMatchMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="6dp"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPauseMatchContains"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/config_screen_match_contains" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPauseMatchExact"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/config_screen_match_exact" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout style="@style/Row">
                <TextView
                    style="@style/RowLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/config_ignore_case_label" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchPauseIgnoreCase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/config_pause_over_clicks_minutes_label"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPauseOverClicksMinutes"
                style="@style/MediumInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="8dp"
                android:hint="5"
                android:inputType="number" />

            <TextView
                android:id="@+id/tvPauseSoundLabel"
                style="@style/RowHint"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="4dp"
                android:text="@string/config_pause_sound_pause_label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickPauseSound"
                style="@style/SparkButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="6dp"
                android:text="@string/config_btn_pick_pause_sound" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickPauseAudioFile"
                style="@style/SparkButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/config_btn_pick_audio_file" />

            <TextView
                android:id="@+id/tvResumeSoundLabel"
                style="@style/RowHint"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="4dp"
                android:text="@string/config_pause_sound_resume_label" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickResumeSound"
                style="@style/SparkButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="6dp"
                android:text="@string/config_btn_pick_resume_sound" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickResumeAudioFile"
                style="@style/SparkButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="14dp"
                android:text="@string/config_btn_pick_audio_file" />
        </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/headerSectionLog"
            style="@style/SectionLabel"
            android:text="@string/config_section_log" />

        <LinearLayout
            android:id="@+id/sectionLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout style="@style/Card">

            <LinearLayout style="@style/Row">
                <TextView
                    style="@style/RowLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/config_debug_log_title" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDebugLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                style="@style/RowHint"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/config_debug_log_hint" />

            <LinearLayout style="@style/Row">
                <TextView
                    style="@style/RowLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/config_file_log_title" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchFileLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareDiagnosticLogs"
                style="@style/SparkButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="14dp"
                android:text="@string/config_btn_share_logs" />
        </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/headerSectionUi"
            style="@style/SectionLabel"
            android:text="INTERFAZ" />

        <LinearLayout
            android:id="@+id/sectionUi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout style="@style/Card">

            <LinearLayout style="@style/Row">
                <TextView
                    style="@style/RowLabel"
                    android:text="Mostrar nombres en la barra lateral" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchShowCategoryNames"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/configFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_page"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveConfig"
            style="@style/SparkButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_btn_save" />

        <TextView
            style="@style/InfoBox"
            android:layout_marginTop="8dp"
            android:text="@string/config_flex_phase_note" />

    </LinearLayout>
</LinearLayout>
