<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="14dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="4dp"
            android:text="AMAZON FLEX" />

        <LinearLayout style="@style/Card">

            <LinearLayout style="@style/Row">
                <TextView
                    style="@style/RowLabel"
                    android:text="Paquete de Amazon Flex" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFlexPackage"
                style="@style/MediumInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="12dp"
                android:hint="com.amazon.rabbit"
                android:inputType="text" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="12dp"
                android:text="@string/config_flex_package_helper"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:text="PERMISOS" />

        <LinearLayout style="@style/Card">

            <LinearLayout style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        style="@style/RowLabel"
                        android:layout_width="match_parent"
                        android:layout_weight="0"
                        android:text="Accesibilidad" />
                    <TextView
                        android:id="@+id/tvAccessStatus"
                        style="@style/RowHint"
                        android:text="No activado" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoAccess"
                style="@style/SparkButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/config_btn_accessibility" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoNotifications"
                style="@style/SparkButtonSecondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="14dp"
                android:text="Acceso a notificaciones (Flex)" />
        </LinearLayout>

        <TextView
            style="@style/SectionLabel"
            android:text="INTERFAZ" />

        <LinearLayout style="@style/Card">

            <LinearLayout style="@style/Row">
                <TextView
                    style="@style/RowLabel"
                    android:text="Mostrar nombres en la barra lateral" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchShowCategoryNames"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveConfig"
            style="@style/SparkButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/config_btn_save" />

        <TextView
            style="@style/InfoBox"
            android:layout_marginTop="12dp"
            android:text="@string/config_flex_phase_note" />

    </LinearLayout>
</ScrollView>
