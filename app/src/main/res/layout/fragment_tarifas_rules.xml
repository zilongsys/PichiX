<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvRulesHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reglas de tarifas"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:drawableEnd="@android:drawable/arrow_down_float"
        android:drawablePadding="6dp"/>

    <LinearLayout
        android:id="@+id/layoutRulesHeaderExpanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prioridad 1 = primero. Tipos: Whole Foods, Amazon.com, Sub Same Day, Otros (cada uno con icono). Pago: bloque, $/h o manual."
            android:textSize="11sp"
            android:textColor="@color/text_hint"
            android:layout_marginBottom="6dp"/>

        <TextView
            style="@style/InfoBox"
            android:text="ⓘ  Sin coincidencia se rechaza. Toca el número azul para cambiar prioridad. Importar copia los criterios de la tarifa rápida."/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvRulesActiveCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 activas"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/green_400"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnImportClassic"
            style="@style/SparkButtonCompact"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:text="Importar rápida"
            android:textAllCaps="false"
            android:layout_marginEnd="6dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddRule"
            style="@style/SparkButtonPrimary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:minWidth="88dp"
            android:text="+ Regla"
            android:textAllCaps="false"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="8dp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRules"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="4dp"/>

    <TextView
        android:id="@+id/tvRulesEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Sin reglas. Pulsa + Regla o Importar."
        android:textColor="@color/text_hint"
        android:textSize="14sp"
        android:visibility="gone"/>

</LinearLayout>
