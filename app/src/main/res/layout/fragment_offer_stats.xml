<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/offer_stats_title"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefreshOfferStats"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/offer_stats_refresh"
                android:textSize="11sp"
                app:icon="@drawable/ic_hist_calendar"
                app:iconSize="16dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOfferStatsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/stat_card"
            android:padding="10dp"
            android:text="@string/offer_stats_empty"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offer_stats_daily_header"
            android:textColor="@color/accent_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvOfferStatsDaily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/stat_card"
            android:padding="10dp"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offer_stats_hourly_header"
            android:textColor="@color/accent_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvOfferStatsHourly"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/stat_card"
            android:padding="10dp"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offer_stats_weekday_header"
            android:textColor="@color/accent_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvOfferStatsWeekday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/stat_card"
            android:padding="10dp"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offer_stats_stations_header"
            android:textColor="@color/accent_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvOfferStatsStations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/stat_card"
            android:padding="10dp"
            android:text="—"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:fontFamily="monospace" />

    </LinearLayout>
</ScrollView>
