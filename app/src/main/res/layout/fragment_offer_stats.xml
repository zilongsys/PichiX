<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offer_stats_title"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offer_stats_range_hint"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            android:layout_marginBottom="6dp" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleOfferStatsRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatsRangeAll"
                style="@style/SparkButtonSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/offer_stats_range_all"
                android:textSize="11sp"
                android:checked="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatsRangeDay"
                style="@style/SparkButtonSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/offer_stats_range_day"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatsRangePeriod"
                style="@style/SparkButtonSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/offer_stats_range_period"
                android:textSize="11sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/tvOfferStatsRangeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/stat_card"
            android:padding="8dp"
            android:text="@string/offer_stats_range_all_label"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <android.widget.GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="1"
            android:alignmentMode="alignBounds"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatsExportAll"
                style="@style/HistorialActionButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/hist_action_btn_height"
                android:layout_columnWeight="1"
                android:layout_row="0"
                android:layout_column="0"
                android:layout_marginEnd="3dp"
                android:backgroundTint="@color/hist_action_csv_bg"
                android:text="@string/offer_stats_export_all"
                android:textSize="10sp"
                app:icon="@drawable/ic_hist_csv" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatsClearToday"
                style="@style/HistorialActionButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/hist_action_btn_height"
                android:layout_columnWeight="1"
                android:layout_row="0"
                android:layout_column="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:backgroundTint="@color/hist_action_today_bg"
                android:text="@string/offer_stats_clear_today"
                android:textSize="10sp"
                app:icon="@drawable/ic_hist_trash_today" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStatsClearAll"
                style="@style/HistorialActionButton"
                android:layout_width="0dp"
                android:layout_height="@dimen/hist_action_btn_height"
                android:layout_columnWeight="1"
                android:layout_row="0"
                android:layout_column="2"
                android:layout_marginStart="3dp"
                android:backgroundTint="@color/hist_action_all_bg"
                android:text="@string/offer_stats_clear_all"
                android:textSize="10sp"
                app:icon="@drawable/ic_hist_trash_all" />
        </android.widget.GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPickOfferStatsDate"
                style="@style/SparkButtonSecondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/offer_stats_pick_day"
                android:textSize="11sp"
                android:visibility="gone"
                app:icon="@drawable/ic_hist_calendar"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRefreshOfferStats"
                style="@style/SparkButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/offer_stats_analyze"
                android:textSize="12sp"
                app:icon="@drawable/ic_hist_calendar"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/button_primary_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOfferStatsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/stat_card"
            android:padding="10dp"
            android:text="@string/offer_stats_empty"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvOfferStatsDailyHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offer_stats_daily_header"
            android:textColor="@color/accent_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <FrameLayout
            android:id="@+id/statsDailyTableHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offer_stats_hourly_header"
            android:textColor="@color/accent_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <FrameLayout
            android:id="@+id/statsHourlyTableHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvOfferStatsWeekdayHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offer_stats_weekday_header"
            android:textColor="@color/accent_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <FrameLayout
            android:id="@+id/statsWeekdayTableHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offer_stats_rate_header"
            android:textColor="@color/accent_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <FrameLayout
            android:id="@+id/statsRatesTableHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/offer_stats_stations_header"
            android:textColor="@color/accent_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <FrameLayout
            android:id="@+id/statsStationsTableHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
