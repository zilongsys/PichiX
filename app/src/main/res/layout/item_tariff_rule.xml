<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/card_bg_elevated"
    android:paddingHorizontal="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Prioridad (número) -->
    <TextView
        android:id="@+id/tvRuleIndex"
        android:layout_width="@dimen/tariff_rule_badge_size"
        android:layout_height="@dimen/tariff_rule_badge_size"
        android:background="@drawable/badge_blue"
        android:clickable="true"
        android:contentDescription="Cambiar prioridad"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:textColor="@color/badge_blue_text"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="1" />

    <!-- Tipo de orden: icono dentro de cuadrado del color del alcance (mismo tamaño que prioridad) -->
    <FrameLayout
        android:id="@+id/frameRuleOrderIcon"
        android:layout_width="@dimen/tariff_rule_badge_size"
        android:layout_height="@dimen/tariff_rule_badge_size"
        android:layout_marginStart="8dp"
        android:background="@drawable/badge_amber"
        app:layout_constraintStart_toEndOf="@id/tvRuleIndex"
        app:layout_constraintTop_toTopOf="@id/tvRuleIndex">

        <ImageView
            android:id="@+id/ivRuleOrderIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_tarifa_pickup"
            app:tint="@color/badge_amber_text" />
    </FrameLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switchRuleEnabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@id/layoutRuleTitleBlock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/layoutRuleTitleBlock" />

    <!-- Nombre de tienda / regla (máximo espacio horizontal) -->
    <LinearLayout
        android:id="@+id/layoutRuleTitleBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="6dp"
        android:minWidth="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/frameRuleOrderIcon"
        app:layout_constraintEnd_toStartOf="@id/switchRuleEnabled"
        app:layout_constraintStart_toEndOf="@id/frameRuleOrderIcon"
        app:layout_constraintTop_toTopOf="@id/frameRuleOrderIcon">

        <TextView
            android:id="@+id/tvRuleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:minWidth="0dp"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Sam's Club #4821" />

        <TextView
            android:id="@+id/tvRuleOrderHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:minWidth="0dp"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            android:visibility="gone"
            tools:text="Multi-parada · ≥4 paradas"
            tools:visibility="visible" />
    </LinearLayout>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierRuleHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="tvRuleIndex,frameRuleOrderIcon,layoutRuleTitleBlock,switchRuleEnabled" />

    <!-- Detalle fila 1 -->
    <LinearLayout
        android:id="@+id/layoutRuleDetailsRow1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:minWidth="0dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/barrierRuleHeader">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:orientation="vertical"
            android:paddingEnd="6dp">

            <TextView
                style="@style/TariffRuleCellLabel"
                android:text="MODO PAGO" />

            <TextView
                android:id="@+id/tvRulePrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:minWidth="0dp"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                tools:text="$10.00 - sin límite" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView
                style="@style/TariffRuleCellLabel"
                android:text="PAGO / DURACIÓN" />

            <TextView
                android:id="@+id/tvRuleRate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:minWidth="0dp"
                android:textColor="@color/green_400"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="$1.60/mi" />

            <TextView
                android:id="@+id/tvRuleMaxMiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:textColor="@color/text_hint"
                android:textSize="10sp"
                android:visibility="gone"
                tools:text="≤12.0 mi"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <!-- Detalle fila 2 -->
    <LinearLayout
        android:id="@+id/layoutRuleDetailsRow2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:minWidth="0dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutRuleDetailsRow1">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:orientation="vertical"
            android:paddingEnd="6dp">

            <TextView
                style="@style/TariffRuleCellLabel"
                android:text="HORARIO / DÍAS" />

            <TextView
                android:id="@+id/tvRuleSchedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:minWidth="0dp"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                tools:text="Lun-Vie · 06:00-14:00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView
                style="@style/TariffRuleCellLabel"
                android:text="KEYWORDS" />

            <TextView
                android:id="@+id/tvRuleKeywords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:minWidth="0dp"
                android:textColor="@color/text_hint"
                android:textSize="10sp"
                tools:text="—" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutRuleActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutRuleDetailsRow2">

        <ImageButton
            android:id="@+id/btnRuleDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Eliminar"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/red_400" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnRuleEdit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Editar"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/text_secondary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
