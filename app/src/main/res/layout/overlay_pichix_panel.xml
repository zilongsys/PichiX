<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayPanelRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/overlayBtnOnOff"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/overlay_fab_bg"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/overlayLabelOnOff"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="ON"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/overlayBtnPause"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/overlay_fab_bg_pause"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/overlayLabelPause"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⏸"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/overlayBtnTestReturn"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/overlay_fab_bg_test"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/overlayLabelTestReturn"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="↩"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </FrameLayout>
</LinearLayout>
