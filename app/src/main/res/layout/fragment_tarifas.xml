<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page"
    android:padding="16dp">

    <LinearLayout style="@style/Card" android:padding="12dp" android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layoutTariffModeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Modo tarifas:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>
            <TextView
                android:id="@+id/tvTariffModeActive"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Clásica"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorAccent"/>
            <TextView
                android:id="@+id/btnToggleModeInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ocultar info"
                android:textSize="11sp"
                android:textColor="@color/colorAccent"
                android:padding="4dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvModeInfo"
            style="@style/InfoBox"
            android:layout_marginBottom="10dp"
            android:text="Tramos por rango de precio (Pickup, Shopping, Multi-paradas)."/>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleTariffMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTariffClassic"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Clásica"
                android:textAllCaps="false"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTariffDetailed"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Detallada"
                android:textAllCaps="false"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/tarifasContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"/>

</LinearLayout>
