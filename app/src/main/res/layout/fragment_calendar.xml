<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/calScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:fillViewport="false"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalPrevMonth"
                style="@style/SparkButtonCompact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◀"
                android:minWidth="0dp"
                android:minHeight="36dp"/>

            <TextView
                android:id="@+id/tvCalMonthTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Junio 2026"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalNextMonth"
                style="@style/SparkButtonCompact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶"
                android:minWidth="0dp"
                android:minHeight="36dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvCalBlockDateHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Totales por fecha del bloque Flex (no del take)."
            android:textSize="8sp"
            android:textColor="@color/text_hint"
            android:fontFamily="monospace"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="4dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalSummaryWeek"
                style="@style/SparkButtonCompact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="3dp"
                android:text="Por semana"
                android:textSize="10sp"
                android:minWidth="0dp"
                android:minHeight="36dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalSummaryMonth"
                style="@style/SparkButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:text="Por mes"
                android:textSize="10sp"
                android:minWidth="0dp"
                android:minHeight="36dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"/>
        </LinearLayout>

        <!-- Meta (½ línea) + Historial del día (½ línea) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginBottom="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_bg"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_marginEnd="3dp">

                <TextView
                    android:id="@+id/tvCalMetaLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meta Lu"
                    android:textSize="9sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="monospace"/>

                <EditText
                    android:id="@+id/etCalDailyMin"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:hint="0"
                    android:inputType="numberDecimal"
                    android:textSize="10sp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp"
                    android:background="@drawable/input_bg"
                    android:maxLines="1"
                    android:fontFamily="monospace"
                    android:imeOptions="actionDone"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalApplyMin"
                    style="@style/SparkButtonCompact"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OK"
                    android:textSize="10sp"
                    android:minWidth="0dp"
                    android:minHeight="30dp"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalOpenDayLog"
                style="@style/SparkButtonPrimary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:text="Historial del día"
                android:textSize="10sp"
                android:minHeight="38dp"
                android:maxLines="2"
                android:gravity="center"
                android:includeFontPadding="false"
                app:icon="@drawable/ic_hist_calendar"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/button_primary_text"/>
        </LinearLayout>

        <com.oceanlab.pichix.ui.CalendarMonthGridView
            android:id="@+id/calMonthGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <!-- Detalle del día compacto -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="8dp"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DETALLE DEL DÍA"
                    android:textSize="9sp"
                    android:textColor="@color/text_hint"
                    android:letterSpacing="0.08"/>

                <TextView
                    android:id="@+id/tvCalDayDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="—"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:singleLine="true"
                    android:ellipsize="end"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvCalDayEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin bloques aceptados ese día (por fecha del bloque)"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:fontFamily="monospace"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/calDayStatsBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <TextView
                        android:id="@+id/tvCalDayEarned"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ganado: $0"
                        android:textSize="11sp"
                        android:textColor="@color/green_400"
                        android:fontFamily="monospace"
                        android:singleLine="true"/>

                    <TextView
                        android:id="@+id/tvCalDayHours"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Horas: 0 h"
                        android:textSize="11sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace"
                        android:singleLine="true"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCalDayAccepted"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Aceptadas: 0"
                        android:textSize="11sp"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace"
                        android:singleLine="true"/>

                    <TextView
                        android:id="@+id/tvCalDayRate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="\$/h: —"
                        android:textSize="11sp"
                        android:textColor="@color/accent_teal_dark"
                        android:fontFamily="monospace"
                        android:singleLine="true"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCalDayMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="10sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="monospace"
                    android:visibility="gone"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutCalDayOffers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/calSummaryPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/cal_summary_bg"
            android:padding="10dp"
            android:layout_marginBottom="6dp"
            android:focusable="false"
            android:focusableInTouchMode="false">

            <TextView
                android:id="@+id/tvCalSummaryTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RESUMEN DEL MES"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/accent_teal_dark"
                android:letterSpacing="0.06"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="4dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Ganado"
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tvCalSumEarned"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="$0"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/green_400"
                        android:fontFamily="monospace"
                        android:singleLine="true"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="4dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Horas"
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tvCalSumHours"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0 h"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace"
                        android:singleLine="true"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="4dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aceptadas"
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tvCalSumAccepted"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:fontFamily="monospace"
                        android:singleLine="true"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="4dp">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="\$/h prom."
                        android:textSize="9sp"
                        android:textColor="@color/text_secondary"/>
                    <TextView
                        android:id="@+id/tvCalSumRate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/accent_teal_dark"
                        android:fontFamily="monospace"
                        android:singleLine="true"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
