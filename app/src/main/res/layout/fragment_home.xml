<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:scrollbars="none"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:focusable="false"
    android:focusableInTouchMode="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ── ESTADO DEL BOT ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_section_status"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.10"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/homeStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/homeStatusBar"
                android:layout_width="4dp"
                android:layout_height="42dp"
                android:background="@color/text_hint"
                android:layout_marginEnd="14dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/homeBotStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● PichiX inactivo"
                    android:textColor="@color/text_hint"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
                <TextView
                    android:id="@+id/homeBotSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Activa el switch del header para comenzar"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ── ACCESOS RÁPIDOS ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_section_quick"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.10"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <!-- Botón flotante -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_overlay_title"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_overlay_hint"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/homeQuickOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/header_switch_thumb"
                app:trackTint="@color/switch_track_selector"/>
        </LinearLayout>

        <!-- Return 2 offers (auto) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_return_2_offers_title"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_return_2_offers_hint"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/homeQuickReturn2Offers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/header_switch_thumb"
                app:trackTint="@color/switch_track_selector"/>
        </LinearLayout>

        <!-- Aceptar automáticamente -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_auto_accept_title"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_auto_accept_hint"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/homeQuickAutoAccept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/header_switch_thumb"
                app:trackTint="@color/switch_track_selector"/>
        </LinearLayout>

        <!-- Modo simulación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_simulation_title"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/home_simulation_hint"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/homeQuickDryRun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/header_switch_thumb"
                app:trackTint="@color/switch_track_selector"/>
        </LinearLayout>

        <!-- Apariencia -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_section_appearance"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.10"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_theme_hint"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/themeToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/homeBtnThemeDark"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_theme_dark"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/homeBtnThemeWhite"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_theme_light"/>

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>

        <!-- Respaldo configuración -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_config_backup_title"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.10"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_config_export_hint"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHomeExportConfig"
                    style="@style/SparkButtonSecondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/home_config_export"
                    android:textSize="11sp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHomeImportConfig"
                    style="@style/SparkButtonSecondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/home_config_import"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
