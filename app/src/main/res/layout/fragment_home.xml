<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:scrollbars="none"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:focusable="false"
    android:focusableInTouchMode="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ── ESTADO DEL BOT ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESTADO"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.10"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:id="@+id/homeStatusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/homeStatusBar"
                android:layout_width="4dp"
                android:layout_height="42dp"
                android:background="@color/text_hint"
                android:layout_marginEnd="14dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/homeBotStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● PichiX inactivo"
                    android:textColor="@color/text_hint"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"/>
                <TextView
                    android:id="@+id/homeBotSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Activa el switch del header para comenzar"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- ── ACCESOS RÁPIDOS ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCESOS RÁPIDOS"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.10"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <!-- Botón flotante -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ Botón flotante"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mostrar botón de control sobre otras aplicaciones"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/homeQuickOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/header_switch_thumb"
                app:trackTint="@color/switch_track_selector"/>
        </LinearLayout>

        <!-- Modo simulación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            xmlns:app="http://schemas.android.com/apk/res-auto">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🧪 Modo simulación"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mismo flujo que en vivo (scroll, cancelar, detalle): solo omite el click en ACCEPT"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp"/>
            </LinearLayout>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/homeQuickDryRun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/header_switch_thumb"
                app:trackTint="@color/switch_track_selector"/>
        </LinearLayout>

        <!-- ── APARIENCIA ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="APARIENCIA"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.10"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selecciona el tema de la aplicación"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/themeToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/homeBtnThemeDark"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌙 Dark"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/homeBtnThemeWhite"
                    style="@style/SparkThemeToggleButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="☀️ White"/>

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
